# Caso 01 - Soporte cliente omnicanal
# Demo by default. Add only the values you really need in LIVE.
# Never commit a populated .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
USE_LLM=true
PORT=8001
HOST=0.0.0.0

# Optional hardening if you expose the backend outside localhost.
# DEMO_AUTH_TOKEN=replace-with-a-long-random-token
# RATE_LIMIT_RPM=60
# TRUST_PROXY_HEADERS=false
