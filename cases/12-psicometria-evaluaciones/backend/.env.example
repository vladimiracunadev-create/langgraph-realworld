# Caso 12 — Psicometría y Evaluaciones
# Copiar a .env y completar valores reales si se desea modo LIVE.

# LIVE opt-in (LLM para reporte ejecutivo enriquecido)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Observabilidad LangSmith (opcional)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=caso-12-psicometria

# Guardrails
# DEMO_AUTH_TOKEN=             # si se setea, /api/* requiere X-Demo-Token
# RATE_LIMIT_RPM=0             # 0 = sin límite
# TRUST_PROXY_HEADERS=false

# OAuth2/OIDC (opt-in)
# USE_OAUTH2=false
# OAUTH2_JWKS_URL=
# OAUTH2_AUDIENCE=
# OAUTH2_ISSUER=
