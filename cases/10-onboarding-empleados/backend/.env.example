# Caso 10 - Onboarding de Empleados
# Demo by default. Add only the integrations you will really activate.
# Never commit a populated .env.

# Variables de entorno por defecto (modo demo - sin coste)
# CHECKPOINT_DB=:memory:    # Desactiva persistencia en tests
# DATA_DIR=../../data       # Sobreescribe directorio de datos

# Guardrails opcionales si expones el backend fuera de localhost.
# DEMO_AUTH_TOKEN=replace-with-a-long-random-token
# RATE_LIMIT_RPM=60
# TRUST_PROXY_HEADERS=false

# ----- Activar IA Real (LLM) -----
# OPENAI_API_KEY=sk-...
# MODEL=gpt-4o-mini

# ----- Google Workspace Real -----
# Usa una ruta a un archivo inyectado por runtime. No pegues JSON sensible aqui.
# GOOGLE_ADMIN_CREDENTIALS_JSON=/ruta/a/tu/service-account.json

# ----- Slack Real -----
# SLACK_BOT_TOKEN=xoxb-...

# ----- GitHub Real -----
# GITHUB_TOKEN=ghp_...

# ----- AWS IAM Real -----
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1

# ----- Email SMTP Real -----
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@empresa.com
# SMTP_PASS=...
