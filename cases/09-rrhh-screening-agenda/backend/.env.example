# Este caso funciona SIN LLM (determinista).
# Nunca comitees credenciales reales.
DATA_DIR="../data"

# Guardrails opcionales si expones el backend fuera de localhost.
# DEMO_AUTH_TOKEN=replace-with-a-long-random-token
# RATE_LIMIT_RPM=60
# TRUST_PROXY_HEADERS=false

# --- Para hacerlo REAL (opcional) ---
# Usa rutas a archivos inyectados por runtime o secretos del sistema; no pegues JSON sensible en Git.

# Uploads / storage
# RESUME_STORAGE_DIR="/app/uploads"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_DEFAULT_REGION="us-east-1"
# S3_BUCKET=""

# Email (SMTP)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_USE_TLS=true

# Email (SendGrid)
# SENDGRID_API_KEY=""
# SENDGRID_FROM_EMAIL="rrhh@tu-dominio.cl"

# Google Calendar (OAuth2)
# GOOGLE_OAUTH_CREDENTIALS_JSON="/run/secrets/google_credentials.json"
# GOOGLE_OAUTH_TOKEN_JSON="/app/token.json"
# GOOGLE_CALENDAR_ID="primary"

