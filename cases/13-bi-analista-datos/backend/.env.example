# Caso 13 - BI Data Analyst
# Demo by default. Never commit a populated .env.

# Desarrollo local portable
# DATA_DIR=../data
# WEB_DIR=../web
# DATABASE_URL=sqlite:///../data/bi_database.sqlite
# PORT=8013
# HOST=0.0.0.0
# ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Guardrails opcionales si expones el backend fuera de localhost.
# DEMO_AUTH_TOKEN=replace-with-a-long-random-token
# RATE_LIMIT_RPM=60
# TRUST_PROXY_HEADERS=false

# Activar LLM real (opcional)
# OPENAI_API_KEY=sk-...
