# Caso 05 — Analista de Documentos
# DEMO por defecto — no necesita credenciales.
DATA_DIR=../data

# LLM (opcional para modo LIVE — habilita análisis narrativo con GPT-4o-mini)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Procesamiento de archivos reales (modo LIVE — instalar dependencias adicionales)
# pip install pymupdf          # extracción de PDFs reales
# pip install python-docx      # extracción de archivos DOCX reales

# Guardrails opcionales
# DEMO_AUTH_TOKEN=replace-with-a-long-random-token
# RATE_LIMIT_RPM=60
# TRUST_PROXY_HEADERS=false

# OAuth2/OIDC (opcional)
# USE_OAUTH2=false
# OAUTH2_JWKS_URL=
# OAUTH2_AUDIENCE=
# OAUTH2_ISSUER=

# Observabilidad (opcional — LangSmith tracing automático)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_...
# LANGCHAIN_PROJECT=langgraph-realworld
