# Caso 19 — DevEx PR Review Agent
# Funciona en modo DEMO sin OPENAI_API_KEY.
# Nunca comitees credenciales reales.

# Ruta al JSON del PR simulado (relativa al working_dir o absoluta)
PR_DATA_PATH="../data/sample_pr.json"

# Puerto del servidor
PORT=8019

# Guardrails opcionales si expones el backend fuera de localhost.
# DEMO_AUTH_TOKEN=replace-with-a-long-random-token
# RATE_LIMIT_RPM=60
# TRUST_PROXY_HEADERS=false

# LangGraph checkpoints
# CHECKPOINT_DB=./checkpoints.sqlite

# --- Para hacerlo REAL (opcional) ---

# LLM (modo LIVE: análisis con GPT en lugar de patrones de texto)
# OPENAI_API_KEY=""
# MODEL="gpt-4.1"

# LangSmith (trazabilidad)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=""
# LANGCHAIN_PROJECT="19-devex-pr-review"

# GitHub Integration (modo LIVE)
# GITHUB_TOKEN=""
# GITHUB_REPO="owner/repo"

# OAuth2 (si expones el backend con autenticación real)
# USE_OAUTH2=false
# OAUTH2_JWKS_URL=""
# OAUTH2_AUDIENCE=""
# OAUTH2_ISSUER=""
