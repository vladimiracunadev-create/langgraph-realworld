# Demo/local only. Never commit real credentials.
# The portal export is a browser-side helper, not an enterprise secret manager.
# Copy only the variables you need into the case-specific backend/.env file.

# LangChain / LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=default

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Deployment / Security
# APP_SECRET=change-me
# ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
